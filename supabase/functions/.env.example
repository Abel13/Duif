# Generate a different secret for every environment. Minimum: 32 characters.
REFERRAL_INVITE_SIGNING_SECRET=replace-with-a-random-environment-specific-secret
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Optional locally. Set true only for a non-commercial prototype using the public endpoint.
OPEN_METEO_ALLOW_PUBLIC_ENDPOINT=false
# Required for commercial production use. Leave empty when the public endpoint is explicitly allowed.
OPEN_METEO_API_KEY=
