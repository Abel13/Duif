VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_DUIF_REQUIRE_PWA_INSTALL=false
# Public VAPID key only. Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# Optional vector basemap. Without this, the map uses the reliable OpenStreetMap raster basemap.
# VITE_MAP_VECTOR_TILES_URL=https://your-vector-tiles.example/{z}/{x}/{y}.pbf
# VITE_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
